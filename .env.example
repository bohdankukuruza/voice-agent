DEEPGRAM_API_KEY=your_deepgram_api_key
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=you@example.com

# Second site served by the same nginx (online shop)
SHOP_DOMAIN=shop.your-domain.com

# Postgres (orders storage)
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=voiceagent

# Shared secret Twilio must pass as ?token=... in the Stream URL.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STREAM_AUTH_TOKEN=change_me_to_a_random_token

# Max call length in seconds before the agent says goodbye and hangs up
CALL_TIME_LIMIT_SECONDS=60

# Max number of calls accepted per rolling 24h window; further callers hear a
# "try again tomorrow" message and hang up before any Deepgram/OpenAI cost.
MAX_CALLS_PER_DAY=10
